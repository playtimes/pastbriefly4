# PastBriefly 4 configuration. Copy to .env for a live run.
# With PROVIDER_MODE=mock (the default) the whole app runs locally and free.

PROVIDER_MODE=mock
PORT=8787
MAX_SPEND_USD=15

# OpenAI: research (Responses API + web search) and still-image generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# ElevenLabs: narration + word alignment. Michael C. Vincent is the reference voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Runway developer API: selective 5s image-to-video motion. Stills are sent
# inline as data URIs, so no public asset URL is needed.
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4.5

# YouTube Data API v3: optional. Real trending/popular signals for the Create
# page's discovery niches. Without it (or in mock mode) niches show as unavailable
# rather than being invented.
YOUTUBE_API_KEY=

# Optional explicit ffmpeg/ffprobe paths (otherwise resolved from PATH / winget).
FFMPEG_PATH=
FFPROBE_PATH=
