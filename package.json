{
  "name": "pastbriefly4",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PastBriefly 4 - pick a true historical story, generate a Short and a long documentary, watch both.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "remotion studio src/render/index.ts",
    "render:paul-bunyan": "tsx src/production/renderPaulBunyan.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
